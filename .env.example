# Copy to .env in the repo root. .env is gitignored and must not be committed.

# OpenAI-compatible generator used by rewriter / pruner / generator.
QWEN_API_KEY=
QWEN_BASE_URL=http://127.0.0.1:8000/v1
QWEN_MODEL=qwen36-rag
QWEN_ENABLE_THINKING=0

# OpenAI-compatible LLMAAJ judge.
CITYU_LLM_KEY=
CITYU_LLM_URL=http://127.0.0.1:8888/v1
CITYU_LLM_MODEL=your-judge-model
